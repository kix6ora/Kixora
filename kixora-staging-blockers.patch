--- /dev/null
+++ b/src/services/healthService.ts
@@ -0,0 +1,20 @@
+// Database health probe used by GET /api/health.
+//
+// The probe deliberately reads the PUBLIC product catalog, which the anon role
+// is meant to read (migration 0031). It must never touch tables that anon is
+// not allowed to read (profiles, orders, ...) and must never be "fixed" by
+// granting anon extra access just to make health pass.
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+export const HEALTH_PROBE_TABLE = 'products';
+
+export type DbHealth = 'healthy' | 'unhealthy';
+
+export async function probeDatabase(client: Pick<SupabaseClient, 'from'>): Promise<DbHealth> {
+  try {
+    const { error } = await client.from(HEALTH_PROBE_TABLE).select('id').limit(1);
+    return error ? 'unhealthy' : 'healthy';
+  } catch {
+    return 'unhealthy';
+  }
+}
