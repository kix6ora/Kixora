index 0000000..49d4046
--- /dev/null
+++ b/src/lib/supabaseAdmin.ts
@@ -0,0 +1,40 @@
+// Server-only Supabase client that uses the service-role key.
+//
+// NEVER import this file from browser code. The key is read from process.env
+// at call time (not at import time) so it cannot be inlined into a Vite bundle,
+// and the function refuses to run if a `window` object exists.
+import { createClient, type SupabaseClient } from '@supabase/supabase-js';
+
+let cached: SupabaseClient | null = null;
+let cachedFor = '';
+
+export function hasServiceRoleKey(): boolean {
+  return typeof window === 'undefined' && Boolean(process.env.SUPABASE_SERVICE_ROLE_KEY);
+}
+
+export function getServiceRoleClient(): SupabaseClient {
+  if (typeof window !== 'undefined') {
+    throw new Error('getServiceRoleClient() must never run in the browser.');
+  }
+
+  const url = process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL || '';
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY || '';
+  if (!url || !key) {
+    throw new Error('Service-role Supabase client is not configured (missing URL or SUPABASE_SERVICE_ROLE_KEY).');
+  }
+
+  const fingerprint = `${url}|${key.length}`;
+  if (!cached || cachedFor !== fingerprint) {
+    cached = createClient(url, key, {
+      auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false },
+    });
+    cachedFor = fingerprint;
+  }
+  return cached;
+}
+
+/** Test helper: drop the cached client. */
+export function resetServiceRoleClientForTests(): void {
+  cached = null;
+  cachedFor = '';
+}
