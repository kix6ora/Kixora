+#!/usr/bin/env node
+// Live boundary checks against the STAGING Supabase project, using only the anon key
+// and test-account logins. It never uses the service-role key.
+//
+//   STAGING_SUPABASE_URL=https://xxxx.supabase.co
+//   STAGING_SUPABASE_ANON_KEY=...                (the public anon key)
+//   STAGING_CUSTOMER_EMAIL / STAGING_CUSTOMER_PASSWORD   (a normal test customer)
+//   STAGING_ADMIN_EMAIL    / STAGING_ADMIN_PASSWORD      (a test admin, role set in the DB by you)
+//   node scripts/staging/auth-check.mjs [--signup] [--try-escalation]
+//
+// --signup           also creates a throwaway customer (email alias) and checks the profile trigger
+// --try-escalation   a customer attempts to set profiles.role='admin' on itself (must not stick)
+//
+// The RPC probes use arguments that cannot change data (random UUIDs, huge TTL).
+// Exit code 1 on any FAIL. Passwords and tokens are never printed.
+import { createClient } from '@supabase/supabase-js';
+import { randomUUID } from 'node:crypto';
+
+const env = (k) => process.env[k] || '';
+const URL_ = env('STAGING_SUPABASE_URL');
+const ANON = env('STAGING_SUPABASE_ANON_KEY');
+if (!URL_ || !ANON) {
+  console.error('Set STAGING_SUPABASE_URL and STAGING_SUPABASE_ANON_KEY.');
+  process.exit(2);
+}
+const wantSignup = process.argv.includes('--signup');
+const wantEscalation = process.argv.includes('--try-escalation');
+
+let fails = 0;
+const out = (level, label, detail = '') => {
+  if (level === 'FAIL') fails++;
+  console.log(`${level.padEnd(4)}  ${label}${detail ? '  -> ' + detail : ''}`);
+};
+const fresh = () => createClient(URL_, ANON, { auth: { persistSession: false, autoRefreshToken: false } });
+
+const ZERO = '00000000-0000-0000-0000-000000000000';
+const rand = () => randomUUID();
+
+// Functions that must NOT be callable by anon or a normal customer.
+const LOCKED = [
+  ['admin_adjust_inventory', () => ({ p_product_size_id: rand(), p_stock_delta: 0, p_admin_id: ZERO })],
+  ['admin_transition_order_status', () => ({ p_order_id: rand(), p_new_status: 'Processing', p_title: 't', p_description: 'd', p_admin_id: ZERO })],
+  ['admin_reconcile_payment_state', () => ({ p_order_id: rand(), p_new_payment_status: 'paid', p_new_order_status: 'Processing', p_gateway_reference: 'authcheck', p_admin_id: ZERO, p_reason: 'authcheck' })],
+  ['confirm_inventory_sale', () => ({ p_order_id: rand(), p_payment_reference: 'authcheck' })],
+  ['release_order_reservations', () => ({ p_order_id: rand(), p_reason: 'authcheck' })],
+  // Huge TTL = matches no order, so this cannot cancel anything even if it runs.
+  ['cleanup_stale_pending_orders', () => ({ p_ttl_minutes: 2147483647 })],
+];
+
+// Classify the outcome of a call that SHOULD be blocked.
+function classify(error) {
+  if (!error) return 'EXECUTED';
+  const msg = `${error.code || ''} ${error.message || ''}`.toLowerCase();
+  if (error.code === '42501' || msg.includes('permission denied')) return 'REVOKED';
+  if (msg.includes('access denied') || msg.includes('admin privileges')) return 'GUARDED';
+  if (error.code === 'PGRST202' || msg.includes('could not find the function')) return 'NOT_FOUND';
+  return 'EXECUTED_WITH_ERROR';
+}
+
+async function probeLocked(client, who, allowGuarded) {
+  for (const [name, args] of LOCKED) {
+    const { error } = await client.rpc(name, args());
+    const c = classify(error);
+    if (c === 'REVOKED') out('PASS', `${who}: ${name} is revoked`);
+    else if (c === 'GUARDED') out(allowGuarded ? 'PASS' : 'WARN', `${who}: ${name} runs but its admin guard blocks it`, allowGuarded ? '' : 'prefer REVOKE so anon cannot even execute it');
+    else if (c === 'NOT_FOUND') out('FAIL', `${who}: ${name} not found by the API (signature mismatch or schema cache)`, error.message);
+    else out('FAIL', `${who}: ${name} EXECUTED (${c})`, error ? error.message : 'no error');
+  }
+}
+
+const SENSITIVE_TABLES = ['orders', 'order_items', 'profiles', 'admin_audit_logs', 'payment_reconciliation_logs', 'webhook_events', 'shipments', 'inventory_reservations'];
+const POLICY_TABLES = ['promo_codes', 'inventory', 'bespoke_designs', 'product_images', 'product_sizes'];
+
+async function probeTables(client, who, { ownIdColumn } = {}) {
+  for (const t of SENSITIVE_TABLES) {
+    const { data, error } = await client.from(t).select('*').limit(5);
+    if (error) out('PASS', `${who}: cannot read ${t}`, error.code || error.message);
+    else if (!data || data.length === 0) out('PASS', `${who}: ${t} returns no rows`);
+    else if (ownIdColumn && who.startsWith('customer') && ['orders', 'profiles'].includes(t)) {
+      const foreign = data.filter((r) => (ownIdColumn[t] ? r[ownIdColumn[t]] !== ownIdColumn.value : false));
+      out(foreign.length ? 'FAIL' : 'PASS', `${who}: ${t} rows are all the caller's own`, foreign.length ? `${foreign.length} foreign rows` : `${data.length} own row(s)`);
+    } else out('FAIL', `${who}: can read ${data.length} row(s) of ${t}`);
+  }
+  for (const t of POLICY_TABLES) {
+    const { data, error } = await client.from(t).select('*').limit(1000);
+    if (!error && data && data.length) out('WARN', `${who}: can read ${data.length} row(s) of ${t}`, 'owner decision: is this meant to be public?');
+  }
+}
+
+// ---------- anon ----------
+console.log('--- anonymous visitor ---');
+const anon = fresh();
+await probeLocked(anon, 'anon', false);
+await probeTables(anon, 'anon');
+
+// ---------- customer ----------
+console.log('\n--- signed-in customer ---');
+const cust = fresh();
+const cEmail = env('STAGING_CUSTOMER_EMAIL'), cPass = env('STAGING_CUSTOMER_PASSWORD');
+if (!cEmail || !cPass) {
+  out('FAIL', 'customer credentials not provided (STAGING_CUSTOMER_EMAIL / PASSWORD)');
+} else {
+  const { data, error } = await cust.auth.signInWithPassword({ email: cEmail, password: cPass });
+  if (error) out('FAIL', 'customer login', error.message);
+  else {
+    out('PASS', 'customer login works');
+    const role = data.user.app_metadata?.role;
+    out(role === 'admin' || role === 'super_admin' ? 'FAIL' : 'PASS', 'customer account has no admin role in app_metadata', `role=${role ?? 'none'}`);
+    await probeLocked(cust, 'customer', true);
+    await probeTables(cust, 'customer', { ownIdColumn: { value: data.user.id, orders: 'user_id', profiles: 'id' } });
+    if (wantEscalation) {
+      await cust.from('profiles').update({ role: 'admin' }).eq('id', data.user.id);
+      const re = fresh();
+      const { data: again } = await re.auth.signInWithPassword({ email: cEmail, password: cPass });
+      const { data: prof } = await re.from('profiles').select('role').eq('id', data.user.id).maybeSingle();
+      const bad = ['admin', 'super_admin'].includes(again?.user?.app_metadata?.role) || ['admin', 'super_admin'].includes(prof?.role);
+      out(bad ? 'FAIL' : 'PASS', 'customer cannot promote itself to admin', `profile.role=${prof?.role ?? 'unreadable'}, app_metadata.role=${again?.user?.app_metadata?.role ?? 'none'}`);
+      if (bad) out('FAIL', 'ACTION NEEDED: reset this test account role in the Supabase SQL editor');
+    }
+  }
+}
+
+// ---------- sign-up ----------
+if (wantSignup) {
+  console.log('\n--- customer sign-up ---');
+  if (!cEmail.includes('@')) out('FAIL', 'need STAGING_CUSTOMER_EMAIL to derive an alias');
+  else {
+    const [u, d] = cEmail.split('@');
+    const alias = `${u.split('+')[0]}+kx${Date.now()}@${d}`;
+    const su = fresh();
+    const { data, error } = await su.auth.signUp({ email: alias, password: `Kx!${randomUUID().slice(0, 12)}` });
+    if (error) out('FAIL', 'sign-up request', error.message);
+    else if (!data.session) out('NOTE', 'sign-up accepted; email confirmation is ON, so no session yet', 'confirm the email, then log in to finish the check by hand');
+    else {
+      out('PASS', 'sign-up returned a session (email confirmation is OFF in this project)');
+      const { data: prof, error: pe } = await su.from('profiles').select('id, role').eq('id', data.user.id).maybeSingle();
+      out(prof ? 'PASS' : 'FAIL', 'profile row was created by the sign-up trigger', pe ? pe.message : `role=${prof?.role}`);
+    }
+  }
+}
+
+// ---------- admin ----------
+console.log('\n--- admin ---');
+const adm = fresh();
+const aEmail = env('STAGING_ADMIN_EMAIL'), aPass = env('STAGING_ADMIN_PASSWORD');
+if (!aEmail || !aPass) {
+  out('FAIL', 'admin credentials not provided (STAGING_ADMIN_EMAIL / PASSWORD)');
+} else {
+  const { data, error } = await adm.auth.signInWithPassword({ email: aEmail, password: aPass });
+  if (error) out('FAIL', 'admin login', error.message);
+  else {
+    const role = data.user.app_metadata?.role;
+    out(['admin', 'super_admin'].includes(role) ? 'PASS' : 'FAIL', 'admin account carries an admin role in app_metadata', `role=${role ?? 'none'}`);
+    const { error: e2 } = await adm.rpc('admin_transition_order_status', { p_order_id: rand(), p_new_status: 'Processing', p_title: 't', p_description: 'd', p_admin_id: data.user.id });
+    const c = classify(e2);
+    out(c === 'GUARDED' || c === 'REVOKED' ? 'FAIL' : 'PASS', 'admin passes the admin guard on admin_transition_order_status', e2 ? e2.message : 'no error');
+  }
+}
+
+console.log(fails ? `\nRESULT: FAIL (${fails})` : '\nRESULT: PASS');
+process.exit(fails ? 1 : 0);
diff --git a/scripts/staging/scan-deployed-bundles.mjs b/scripts/staging/scan-deployed-bundles.mjs
new file mode 100644
index 0000000..7270ba2
--- /dev/null
+++ b/scripts/staging/scan-deployed-bundles.mjs
@@ -0,0 +1,182 @@
+#!/usr/bin/env node
+// Scan the frontend that Render is ACTUALLY SERVING for server-only secrets.
+//
+// Usage:
+//   node scripts/staging/scan-deployed-bundles.mjs https://customer.onrender.com https://admin.onrender.com
+//
+// To check secret VALUES, export the same values you set on Render into your
+// local shell first (they are only compared in memory and never printed):
+//   SUPABASE_SERVICE_ROLE_KEY PAYFAST_PASSPHRASE RESEND_API_KEY
+//   THE_COURIER_GUY_API_KEY SHIPPING_WEBHOOK_SECRET GEMINI_API_KEY
+//   (+ SCAN_EXTRA_SECRETS="value1,value2" for anything else)
+// If a variable is not exported, its value check is reported as SKIPPED, not passed.
+//
+// Exit code 1 on any FAIL.
+
+const SECRET_ENV_NAMES = [
+  'SUPABASE_SERVICE_ROLE_KEY',
+  'PAYFAST_PASSPHRASE',
+  'RESEND_API_KEY',
+  'THE_COURIER_GUY_API_KEY',
+  'SHIPPING_WEBHOOK_SECRET',
+  'GEMINI_API_KEY',
+];
+
+const MAX_FILES = 400;
+const results = [];
+const add = (level, url, rule, detail = '') => results.push({ level, url, rule, detail });
+
+const urls = process.argv.slice(2).filter((a) => /^https?:\/\//.test(a)).map((u) => u.replace(/\/+$/, ''));
+if (urls.length === 0) {
+  console.error('Pass at least one deployed base URL.');
+  process.exit(2);
+}
+
+const secretValues = new Map(); // name -> value
+const skipped = [];
+for (const name of SECRET_ENV_NAMES) {
+  const v = process.env[name];
+  if (v && v.trim().length >= 8) secretValues.set(name, v.trim());
+  else skipped.push(name);
+}
+(process.env.SCAN_EXTRA_SECRETS || '').split(',').map((s) => s.trim()).filter((s) => s.length >= 8)
+  .forEach((v, i) => secretValues.set(`EXTRA_${i + 1}`, v));
+
+async function get(url) {
+  try {
+    const res = await fetch(url, { redirect: 'follow', headers: { 'user-agent': 'kixora-bundle-scan/1.0' } });
+    const type = res.headers.get('content-type') || '';
+    const body = await res.text();
+    return { status: res.status, type, body };
+  } catch (e) {
+    return { status: 0, type: '', body: '', error: String(e.message || e) };
+  }
+}
+
+const looksLikeHtml = (r) => /text\/html/i.test(r.type) || /^\s*<!doctype html/i.test(r.body);
+
+function decodeJwtPayload(token) {
+  try {
+    const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
+    return JSON.parse(Buffer.from(part, 'base64').toString('utf8'));
+  } catch {
+    return null;
+  }
+}
+
+function scanText(base, file, text) {
+  // 1) exact secret values
+  for (const [name, value] of secretValues) {
+    if (text.includes(value) || text.includes(encodeURIComponent(value))) {
+      add('FAIL', `${base}${file}`, 'secret value present', `${name} (value not shown)`);
+    }
+  }
+  // 2) JWTs
+  const jwtRe = /eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/g;
+  const seen = new Set();
+  for (const m of text.matchAll(jwtRe)) {
+    if (seen.has(m[0])) continue;
+    seen.add(m[0]);
+    const payload = decodeJwtPayload(m[0]);
+    const role = payload?.role;
+    if (role === 'service_role') add('FAIL', `${base}${file}`, 'service_role JWT in served file', 'role=service_role');
+    else if (role === 'anon') add('INFO', `${base}${file}`, 'anon JWT present (expected)', `project ref: ${payload.ref || 'n/a'}`);
+    else add('WARN', `${base}${file}`, 'unrecognised JWT in served file', `role=${role ?? 'none'}`);
+  }
+  // 3) new-style Supabase keys and other key shapes
+  const shapes = [
+    [/sb_secret_[A-Za-z0-9_-]{16,}/g, 'Supabase secret key (sb_secret_)', 'FAIL'],
+    [/sk_live_[A-Za-z0-9]{10,}/g, 'sk_live_ key', 'FAIL'],
+    [/sk_test_[A-Za-z0-9]{10,}/g, 'sk_test_ key', 'FAIL'],
+    [/\bre_[A-Za-z0-9]{20,}/g, 'Resend API key shape', 'FAIL'],
+    [/AIza[0-9A-Za-z_-]{35}/g, 'Google/Gemini API key shape', 'FAIL'],
+  ];
+  for (const [re, label, level] of shapes) {
+    if (re.test(text)) add(level, `${base}${file}`, label, 'pattern match (value not shown)');
+  }
+  // 4) server-only variable NAMES (not fatal, but should not be in browser code)
+  for (const name of SECRET_ENV_NAMES) {
+    if (text.includes(name)) add('WARN', `${base}${file}`, 'server-only variable NAME in served file', name);
+  }
+}
+
+function extractAssetPaths(text, fileUrl, base) {
+  const found = new Set();
+  const abs = /(?:src|href)=["']([^"']+)["']/g;
+  for (const m of text.matchAll(abs)) found.add(m[1]);
+  for (const m of text.matchAll(/assets\/[A-Za-z0-9_.\-]+\.(?:js|css|mjs)/g)) found.add('/' + m[0]);
+  for (const m of text.matchAll(/["'`](\.{1,2}\/[A-Za-z0-9_.\-/]+\.(?:js|css|mjs))["'`]/g)) found.add(m[1]);
+  const out = [];
+  for (const p of found) {
+    try {
+      const u = new URL(p, fileUrl);
+      if (u.origin === new URL(base).origin && /\.(js|css|mjs|json|webmanifest)$/i.test(u.pathname)) out.push(u.pathname);
+    } catch { /* ignore */ }
+  }
+  return out;
+}
+
+async function scanSite(base) {
+  const home = await get(`${base}/`);
+  if (home.status !== 200) {
+    add('FAIL', base, 'site not reachable', `HTTP ${home.status} ${home.error || ''}`.trim());
+    return;
+  }
+  add('INFO', base, 'home page fetched', `HTTP ${home.status}`);
+
+  const queue = [...new Set(extractAssetPaths(home.body, `${base}/`, base))];
+  const done = new Set();
+  const supabaseUrls = new Set();
+  const siteHosts = new Set();
+  let scanned = 0;
+
+  scanText(base, '/', home.body);
+
+  while (queue.length && scanned < MAX_FILES) {
+    const path = queue.shift();
+    if (done.has(path)) continue;
+    done.add(path);
+    const r = await get(`${base}${path}`);
+    if (r.status !== 200 || looksLikeHtml(r)) continue;
+    scanned++;
+    scanText(base, path, r.body);
+    for (const m of r.body.matchAll(/https?:\/\/([a-z0-9-]+\.supabase\.co)/gi)) supabaseUrls.add(m[1].toLowerCase());
+    for (const m of r.body.matchAll(/https?:\/\/([a-z0-9.-]+\.onrender\.com|[a-z0-9.-]+\.vercel\.app)/gi)) siteHosts.add(m[1].toLowerCase());
+    if (/\.(js|mjs)$/i.test(path)) {
+      for (const p of extractAssetPaths(r.body, `${base}${path}`, base)) if (!done.has(p)) queue.push(p);
+      // source map next to a JS file?
+      const map = await get(`${base}${path}.map`);
+      if (map.status === 200 && !looksLikeHtml(map)) add('FAIL', `${base}${path}.map`, 'source map is publicly served', 'exposes original source');
+    }
+  }
+  add('INFO', base, 'files scanned', String(scanned));
+
+  const realSupabase = [...supabaseUrls].filter((h) => h !== 'placeholder.supabase.co');
+  if (realSupabase.length === 0) {
+    add('FAIL', base, 'no real Supabase project URL baked into the build',
+      'Only the placeholder was found: VITE_SUPABASE_URL was not available at build time, so the storefront falls back to mock data.');
+  } else {
+    add('INFO', base, 'Supabase project host(s) baked in', realSupabase.join(', '));
+  }
+  if (siteHosts.size) add('INFO', base, 'site hostnames baked in (VITE_*_DOMAIN / ORIGIN)', [...siteHosts].join(', '));
+
+  // Files that must never be reachable
+  const probes = ['/server.cjs', '/server.cjs.map', '/dist/server.cjs', '/.env', '/.env.production', '/package.json', '/server.ts', '/src/config/env.ts', '/.git/config'];
+  for (const p of probes) {
+    const r = await get(`${base}${p}`);
+    if (r.status === 200 && !looksLikeHtml(r)) add('FAIL', `${base}${p}`, 'sensitive path is publicly served', `HTTP 200, ${r.type || 'no content-type'}`);
+  }
+}
+
+for (const base of urls) await scanSite(base);
+
+// Report
+const order = { FAIL: 0, WARN: 1, INFO: 2 };
+results.sort((a, b) => order[a.level] - order[b.level]);
+for (const r of results) console.log(`${r.level.padEnd(4)}  ${r.url}  ${r.rule}${r.detail ? '  -> ' + r.detail : ''}`);
+console.log('');
+if (skipped.length) console.log(`SKIPPED value checks (variable not exported locally): ${skipped.join(', ')}`);
+console.log(`Value checks ran for: ${[...secretValues.keys()].join(', ') || 'none'}`);
+const fails = results.filter((r) => r.level === 'FAIL').length;
+console.log(fails ? `RESULT: FAIL (${fails})` : 'RESULT: PASS (no FAIL findings)');
+process.exit(fails ? 1 : 0);
