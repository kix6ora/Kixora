new file mode 100644
index 0000000..138c629
--- /dev/null
+++ b/tests/unit/healthService.test.ts
@@ -0,0 +1,34 @@
+import { describe, it, expect, vi } from 'vitest';
+import { probeDatabase, HEALTH_PROBE_TABLE } from '../../src/services/healthService';
+
+function fakeClient(result: { error: unknown } | 'throw') {
+  const limit = vi.fn(async () => {
+    if (result === 'throw') throw new Error('network down');
+    return result;
+  });
+  const select = vi.fn(() => ({ limit }));
+  const from = vi.fn(() => ({ select }));
+  return { client: { from } as any, from, select, limit };
+}
+
+describe('probeDatabase', () => {
+  it('probes the public catalog, never profiles', async () => {
+    const { client, from } = fakeClient({ error: null });
+    await probeDatabase(client);
+    expect(from).toHaveBeenCalledWith(HEALTH_PROBE_TABLE);
+    expect(HEALTH_PROBE_TABLE).toBe('products');
+    expect(from).not.toHaveBeenCalledWith('profiles');
+  });
+
+  it('reports healthy when the query succeeds (even with zero rows)', async () => {
+    expect(await probeDatabase(fakeClient({ error: null }).client)).toBe('healthy');
+  });
+
+  it('reports unhealthy on a permission or API error', async () => {
+    expect(await probeDatabase(fakeClient({ error: { code: '42501', message: 'permission denied' } }).client)).toBe('unhealthy');
+  });
+
+  it('reports unhealthy when the request throws', async () => {
+    expect(await probeDatabase(fakeClient('throw').client)).toBe('unhealthy');
+  });
+});
