+describe('supabaseAdmin (server-only service-role client)', () => {
+  const saved = { ...process.env };
+  beforeEach(() => resetServiceRoleClientForTests());
+  afterEach(() => {
+    process.env = { ...saved };
+    vi.unstubAllGlobals();
+  });
+
+  it('throws when the service-role key is missing', () => {
+    delete process.env.SUPABASE_SERVICE_ROLE_KEY;
+    process.env.VITE_SUPABASE_URL = 'https://example.supabase.co';
+    vi.stubGlobal('window', undefined);
+    expect(hasServiceRoleKey()).toBe(false);
+    expect(() => getServiceRoleClient()).toThrow(/not configured/);
