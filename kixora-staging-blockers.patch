+#!/usr/bin/env node
+// Staging smoke test: health, readiness, CORS, exposed files, and admin/customer UI separation.
+//
+//   STAGING_CUSTOMER_URL=https://customer.onrender.com \
+//   STAGING_ADMIN_URL=https://admin.onrender.com \
+//   node scripts/staging/smoke.mjs            (add --no-browser to skip the UI checks)
+//
+// Local rehearsal over plain http: add --allow-http
+// Exit code 1 on any FAIL. Nothing secret is read or printed.
+
+const customer = (process.env.STAGING_CUSTOMER_URL || '').replace(/\/+$/, '');
+const admin = (process.env.STAGING_ADMIN_URL || '').replace(/\/+$/, '');
+const allowHttp = process.argv.includes('--allow-http');
+const useBrowser = !process.argv.includes('--no-browser');
+
+if (!customer || !admin) {
+  console.error('Set STAGING_CUSTOMER_URL and STAGING_ADMIN_URL.');
+  process.exit(2);
+}
+
+let fails = 0;
+const line = (ok, label, detail = '') => {
+  if (!ok) fails++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? '  -> ' + detail : ''}`);
+};
+const note = (label, detail = '') => console.log(`NOTE  ${label}${detail ? '  -> ' + detail : ''}`);
+
+async function req(url, init = {}) {
+  try {
+    const res = await fetch(url, { redirect: 'manual', ...init });
+    const text = await res.text();
+    return { res, text, status: res.status };
+  } catch (e) {
+    return { res: null, text: '', status: 0, error: String(e.message || e) };
+  }
+}
+
+// 1. URL sanity
+const cu = new URL(customer), au = new URL(admin);
+line(cu.host !== au.host, 'customer and admin hostnames are different', `${cu.host} vs ${au.host}`);
+if (!allowHttp) line(cu.protocol === 'https:' && au.protocol === 'https:', 'both URLs use https');
+
+// 2. Health + readiness on BOTH services
+for (const [name, base] of [['customer', customer], ['admin', admin]]) {
+  const h = await req(`${base}/api/health`);
+  let body = {};
+  try { body = JSON.parse(h.text); } catch { /* ignore */ }
+  line(h.status === 200 && body.status === 'ok' && body.checks?.database === 'healthy',
+    `${name}: /api/health is healthy`, `HTTP ${h.status} ${h.text.slice(0, 160)}`);
+
+  const r = await req(`${base}/api/ready`);
+  let rb = {};
+  try { rb = JSON.parse(r.text); } catch { /* ignore */ }
+  line(r.status === 200 && rb.checks?.configuration === true, `${name}: /api/ready reports configuration valid`, `HTTP ${r.status}`);
+  line(rb.checks?.serviceRoleConfigured === true, `${name}: service-role key present on the server (needed by the PayFast webhook)`);
+  line(rb.checks?.payfastWebhookConfigured === true, `${name}: PayFast passphrase configured`);
+}
+
+// 3. CORS behaviour (production allowlist returns 403 for unknown origins)
+const origins = [cu.origin, au.origin];
+for (const target of [customer, admin]) {
+  for (const o of origins) {
+    const r = await req(`${target}/api/csrf-token`, { headers: { Origin: o } });
+    const acao = r.res?.headers.get('access-control-allow-origin');
+    line(r.status === 200 && acao === o, `CORS: ${new URL(target).host} accepts origin ${o}`, `HTTP ${r.status}, ACAO=${acao}`);
+  }
+  const bad = await req(`${target}/api/csrf-token`, { headers: { Origin: 'https://evil.example' } });
+  const badAcao = bad.res?.headers.get('access-control-allow-origin');
+  line(bad.status === 403 && !badAcao, `CORS: ${new URL(target).host} rejects https://evil.example`, `HTTP ${bad.status}, ACAO=${badAcao}`);
+}
+
+// 4. Files that must not be served (SPA fallback returning index.html is fine)
+for (const base of [customer, admin]) {
+  for (const p of ['/server.cjs', '/server.cjs.map', '/.env', '/package.json']) {
+    const r = await req(`${base}${p}`);
+    const ct = r.res?.headers.get('content-type') || '';
+    const exposed = r.status === 200 && !/text\/html/i.test(ct);
+    line(r.status !== 0 && !exposed, `${new URL(base).host}${p} is not served`, r.status === 0 ? `could not reach host: ${r.error}` : `HTTP ${r.status} ${ct}`);
+  }
+}
+
+// 5. UI separation in a real browser
+if (useBrowser) {
+  let chromium;
+  try { ({ chromium } = await import('@playwright/test')); } catch { note('Playwright not installed; skipping UI checks'); }
+  if (chromium) {
+    let browser;
+    try {
+      browser = await chromium.launch({ executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE || undefined });
+    } catch (e) {
+      line(false, 'browser could not launch (run: npx playwright install chromium)', String(e.message).split('\n')[0]);
+    }
+    if (browser) try {
+      for (const [name, base] of [['customer', customer], ['admin', admin]]) {
+        const page = await browser.newPage();
+        const failed = [];
+        page.on('response', (r) => { if (r.status() >= 400) failed.push(`${r.status()} ${new URL(r.url()).host}${new URL(r.url()).pathname}`); });
+        await page.goto(`${base}/`, { waitUntil: 'networkidle', timeout: 60000 }).catch(() => {});
+        const adminBtn = await page.locator('#header-admin-profile-button').count();
+        const userBtn = await page.locator('#header-user-button').count();
+        if (name === 'customer') {
+          line(adminBtn === 0 && userBtn > 0, 'customer host: no admin entry point in the navbar', `adminBtn=${adminBtn} userBtn=${userBtn}`);
+          // The app has no /admin URL path: it is a single-page app. A direct hit must still show no admin UI.
+          await page.goto(`${base}/admin`, { waitUntil: 'networkidle', timeout: 60000 }).catch(() => {});
+          const leaked = await page.locator('#admin-email, #admin-route-forbidden').count();
+          line(leaked === 0, 'customer host: /admin shows no admin login or admin panel', `found=${leaked}`);
+        } else {
+          line(adminBtn > 0, 'admin host: admin entry button is present (VITE_ADMIN_DOMAIN matches this hostname)', `adminBtn=${adminBtn}`);
+          if (adminBtn > 0) {
+            await page.locator('#header-admin-profile-button').click();
+            await page.waitForTimeout(800);
+            const gate = await page.locator('#admin-email').count();
+            line(gate > 0, 'admin host: signed-out visitor is shown the admin login, not the admin panel', `loginForm=${gate}`);
+          }
+          const storefront = await page.locator('#header-user-button').count();
+          note('admin host root renders the storefront first (the app always starts on the "store" view)', `customer-style user button present: ${storefront > 0}`);
+        }
+        const unique = [...new Set(failed)].slice(0, 12);
+        note(`${name}: network responses >= 400 while loading`, unique.length ? unique.join(' | ') : 'none');
+        await page.close();
+      }
+    } finally {
+      await browser.close();
+    }
+  }
+}
+
+console.log(fails ? `\nRESULT: FAIL (${fails})` : '\nRESULT: PASS');
+process.exit(fails ? 1 : 0);
